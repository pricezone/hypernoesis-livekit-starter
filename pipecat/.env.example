# Copy to .env.local, then: set -a; . ./.env.local; set +a; uv run python -m hn_pipecat
# On a HyperNoesis server these are set for you; provider keys are yours and
# stay on your server.

# --- LiveKit (required; HN_AGENT_API_KEY / HN_AGENT_API_SECRET also work) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Dispatch (this worker joins rooms from LiveKit webhooks) ---
# HN_AGENT_NAME=hypernoesis-pipecat   # shown in the console; prefix of the bot's identity
# HN_ROOM_PREFIX=                     # only rooms whose name starts with this (empty = all)
# HN_MAX_ROOMS=8                      # rooms served at the same time
# HN_JOIN_TIMEOUT=60                  # seconds to wait for a caller after joining
# HN_HTTP_HOST=0.0.0.0
# HN_HTTP_PORT=8081                   # POST /webhook, GET /, GET /worker
# HN_LOG_LEVEL=INFO

# --- Settings from HyperNoesis (not secrets; optional) ---
# HN_AGENT_CONFIG_URL=
# HN_AGENT_TOKEN=
# HN_CACHE_DIR=/tmp

# --- LLM: set at least one ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=                     # or GEMINI_API_KEY

# --- Speech-to-text: a key, or the free local service ---
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# SPEECHMATICS_API_KEY=
# HN_STT_URL=http://127.0.0.1:8000/v1 # OpenAI-compatible /v1/audio/transcriptions
# HN_STT_MODEL=whisper-1

# --- Text-to-speech: a key, or the free local service ---
# CARTESIA_API_KEY=
# HN_TTS_URL=http://127.0.0.1:8001/v1 # OpenAI-compatible /v1/audio/speech (pcm)
# HN_TTS_MODEL=tts-1
# HN_TTS_VOICE=

# --- HyperNoesis API (admins only) ---
# HN_GATEWAY_URL=
# HN_GATEWAY_TOKEN=

# --- Noise cancellation (DeepFilterNet3; the image sets the paths) ---
# HN_DFN_LIB=/opt/deepfilternet/libdf.so
# HN_DFN_MODEL=/opt/deepfilternet/DeepFilterNet3_onnx.tar.gz
# HN_NC_ATTENUATION_DB=100
