# Copy to .env.local, then: set -a; . ./.env.local; set +a; uv run python -m hn_agent dev
# On a HyperNoesis server these are set for you; provider keys are yours and
# stay on your server.

# --- LiveKit (required) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent identity and dispatch ---
# HN_AGENT_NAME=hypernoesis-starter   # explicit dispatch by this name
# HN_AUTO_DISPATCH=false              # true = join every new room automatically

# --- Settings from HyperNoesis (not secrets; optional) ---
# HN_AGENT_CONFIG_URL=
# HN_AGENT_TOKEN=
# HN_CACHE_DIR=/tmp

# --- LLM: set at least one ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=                     # or GEMINI_API_KEY

# --- Speech-to-text: a key, or the free local service ---
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# SPEECHMATICS_API_KEY=
# HN_STT_URL=http://127.0.0.1:8000/v1 # OpenAI-compatible /v1/audio/transcriptions
# HN_STT_MODEL=whisper-1

# --- Text-to-speech: a key, or the free local service ---
# CARTESIA_API_KEY=
# HN_TTS_URL=http://127.0.0.1:8001/v1 # OpenAI-compatible /v1/audio/speech
# HN_TTS_MODEL=tts-1
# HN_TTS_VOICE=

# --- HyperNoesis API (admins only) ---
# HN_GATEWAY_URL=
# HN_GATEWAY_TOKEN=

# --- Noise cancellation (DeepFilterNet3; the image sets the paths) ---
# HN_DFN_LIB=/opt/deepfilternet/libdf.so
# HN_DFN_MODEL=/opt/deepfilternet/DeepFilterNet3_onnx.tar.gz
# HN_NC_ATTENUATION_DB=100
